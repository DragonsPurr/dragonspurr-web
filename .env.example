# EmailJS (for Contact form)
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_USER_ID=

# Sanity

# NEXT_PUBLIC_SANITY_DATASET="production"
# NEXT_PUBLIC_SANITY_PROJECT_ID="xxxxxxx"

# Umami Analytics
#NEXT_PUBLIC_UMAMI_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Medusa storefront (Shop at /shop)
# Prefer server-only vars in production so keys are read at runtime, not baked in at build.
# MEDUSA_BACKEND_URL=https://shopadmin.dragonspurr.ca
# MEDUSA_PUBLISHABLE_KEY=pk_...
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Stripe (must match Medusa backend STRIPE_API_KEY; enable Stripe on the region in Medusa Admin)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# OVH S3-compatible user assets (customer profile photos)
# Public bucket URL: https://dp-user-assets.s3.ca-east-tor.io.cloud.ovh.net/
# OVH_USER_ASSETS_S3_ENDPOINT=https://s3.ca-east-tor.io.cloud.ovh.net
# OVH_USER_ASSETS_S3_BUCKET=dp-user-assets
# OVH_USER_ASSETS_S3_REGION=ca-east-tor
# OVH_USER_ASSETS_S3_ACCESS_KEY=
# OVH_USER_ASSETS_S3_SECRET_KEY=
# OVH_USER_ASSETS_PUBLIC_URL=https://dp-user-assets.s3.ca-east-tor.io.cloud.ovh.net

# Google Maps Platform (address autocomplete on new address form)
# In Google Cloud (same project as the API key), enable:
#   - Maps JavaScript API
#   - Places API (New)  — places.googleapis.com (required; legacy "Places API" alone is not enough)
# Billing must be on. Restrict the browser key to HTTP referrers (localhost + production).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=