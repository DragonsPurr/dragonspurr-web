# Sanity

# NEXT_PUBLIC_SANITY_DATASET="production"
# NEXT_PUBLIC_SANITY_PROJECT_ID="xxxxxxx"

# Medusa storefront (Shop at /shop)
# Prefer server-only vars in production so keys are read at runtime, not baked in at build.
# MEDUSA_BACKEND_URL=https://shopadmin.dragonspurr.ca
# MEDUSA_PUBLISHABLE_KEY=pk_...
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Stripe (must match Medusa backend STRIPE_API_KEY; enable Stripe on the region in Medusa Admin)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# OVH S3-compatible object storage (shared credentials for all buckets)
# OVH_S3_ENDPOINT=https://s3.ca-east-tor.io.cloud.ovh.net
# OVH_S3_REGION=ca-east-tor
# OVH_S3_ACCESS_KEY=
# OVH_S3_SECRET_KEY=

# User assets bucket (customer profile photos)
# OVH_USER_ASSETS_S3_BUCKET=dp-user-assets
# OVH_USER_ASSETS_PUBLIC_URL=https://dp-user-assets.s3.ca-east-tor.io.cloud.ovh.net

# Site assets bucket (logos, static images)
# OVH_SITE_ASSETS_S3_BUCKET=dp-assets
# OVH_SITE_ASSETS_PUBLIC_URL=https://dp-assets.s3.ca-east-tor.io.cloud.ovh.net

# Sentry (error monitoring, tracing, session replay)
# NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.de.sentry.io/...
# SENTRY_DSN=https://...@o....ingest.de.sentry.io/...
# SENTRY_ORG=boxingoctopuscreative
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...  (source map upload; set in CI / .env.sentry-build-plugin)

# Google Maps Platform (address autocomplete on new address form)
# In Google Cloud (same project as the API key), enable:
#   - Maps JavaScript API
#   - Places API (New)  — places.googleapis.com (required; legacy "Places API" alone is not enough)
# Billing must be on. Restrict the browser key to HTTP referrers (localhost + production).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=